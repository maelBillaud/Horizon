  "digest": {
    "max_items": 21,
    "profile_order": ["politique-fr", "sport", "ia", "tech"],
    "category_groups": {
      "politique-gauche": {"name": "Politique - gauche", "limit": 2, "categories": ["politique-gauche"]},
      "politique-centre": {"name": "Politique - centre et service public", "limit": 2, "categories": ["politique-centre"]},
      "politique-droite": {"name": "Politique - droite", "limit": 2, "categories": ["politique-droite"]},
      "sport": {"name": "Sport", "limit": 5, "categories": ["sport"]},
      "ia": {"name": "IA", "limit": 5, "categories": ["ia"]},
      "tech": {"name": "Technologies", "limit": 5, "categories": ["tech"]}
    },
    "default_group": "other",
    "default_group_limit": 1
  }
