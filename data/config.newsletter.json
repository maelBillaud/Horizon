  "collection": {"time_window_hours": 24},
  "processing": {
    "profiles_dir": "profiles-fr",
    "default_profile": "politique-fr",
    "profile_settings": {
      "politique-fr": {"threshold": 6.0, "topic_dedup": false},
      "sport": {"threshold": 6.0, "topic_dedup": true},
      "ia": {"threshold": 7.0, "topic_dedup": true},
      "tech": {"threshold": 6.0, "topic_dedup": true}
    }
